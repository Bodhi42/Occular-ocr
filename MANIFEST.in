include LICENSE LICENSE-pyctcdecode WEIGHTS_LICENSE.md README.md CHANGELOG.md requirements.txt
recursive-include occular *.py
recursive-include occular *.json
prune occular/weights
prune assets
prune tests
global-exclude *.onnx *.jpg *.jpeg *.png *.ipynb *.pyc

global-exclude *.dll

recursive-include examples *.py
recursive-include docs *.md
prune research
prune release_artifacts
include tools/prepare_wsp_weights.py
